---
import Wordmark from './Wordmark.astro';
import { navigation, previewBase } from '../data/site';

const pathname = Astro.url.pathname;

const isCurrent = (href: string) => {
	if (href === `${previewBase}/`) return pathname === href;
	return pathname.startsWith(href);
};
---

<header class="site-header">
	<div class="container header-inner">
		<Wordmark href={`${previewBase}/`} />
		<nav aria-label="Main navigation">
			<ul>
				{navigation.map((item) => (
					<li>
						<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		border-bottom: 1px solid var(--line);
		background: rgb(248 250 249 / 94%);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		min-height: 5rem;
	}

	nav ul {
		display: flex;
		align-items: center;
		gap: clamp(0.65rem, 2vw, 1.5rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		position: relative;
		color: var(--muted);
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--navy-950);
	}

	nav a[aria-current='page']::after {
		position: absolute;
		right: 0;
		bottom: -0.55rem;
		left: 0;
		height: 2px;
		background: var(--orange-500);
		content: '';
	}

	@media (max-width: 61rem) {
		.header-inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.8rem;
			padding-block: 1rem;
		}

		nav {
			width: 100%;
			overflow-x: auto;
			padding-bottom: 0.55rem;
		}

		nav ul {
			width: max-content;
		}
	}
</style>
