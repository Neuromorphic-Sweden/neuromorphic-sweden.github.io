---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['signal-field', { compact }]} aria-hidden="true">
	<svg viewBox="0 0 720 440" role="presentation">
		<g class="grid">
			<path d="M40 80H680M40 160H680M40 240H680M40 320H680M120 40V400M240 40V400M360 40V400M480 40V400M600 40V400" />
		</g>
		<g class="traces">
			<path d="M40 107h86l11-50 17 103 18-53h95l12-24 19 48 14-24h91l16-67 20 121 18-54h92l12-31 16 58 13-27h90" />
			<path d="M40 258h54l14-30 17 58 18-28h78l12-90 22 170 21-80h68l15-47 21 91 18-44h66l15-22 15 42 12-20h92" />
		</g>
		<g class="events">
			<circle cx="137" cy="57" r="5" />
			<circle cx="419" cy="40" r="5" />
			<circle cx="233" cy="168" r="5" />
			<circle cx="359" cy="211" r="5" />
			<circle cx="479" cy="236" r="5" />
		</g>
	</svg>
</div>

<style>
	.signal-field {
		position: relative;
		min-height: 22rem;
		border: 1px solid rgb(200 217 225 / 55%);
		border-radius: 1.25rem;
		background: linear-gradient(145deg, rgb(255 255 255 / 80%), rgb(231 240 243 / 55%));
		box-shadow: var(--shadow-soft);
	}

	.signal-field.compact {
		min-height: 13rem;
	}

	svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		padding: 1rem;
	}

	.grid path {
		fill: none;
		stroke: var(--blue-200);
		stroke-width: 1;
	}

	.traces path {
		fill: none;
		stroke: var(--navy-800);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.events circle {
		fill: var(--orange-500);
		transform-box: fill-box;
		transform-origin: center;
		animation: pulse 3.4s ease-in-out infinite;
	}

	.events circle:nth-child(2) { animation-delay: 0.5s; }
	.events circle:nth-child(3) { animation-delay: 1.1s; }
	.events circle:nth-child(4) { animation-delay: 1.7s; }
	.events circle:nth-child(5) { animation-delay: 2.3s; }

	@keyframes pulse {
		0%, 65%, 100% { opacity: 0.35; transform: scale(0.8); }
		12% { opacity: 1; transform: scale(1.45); }
	}
</style>
