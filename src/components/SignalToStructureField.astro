---
const traces = [
	'M24 62c18-2 24 4 38 0s22-5 34 0 18 3 30-1 20-8 31 0 20 5 34-1 22-4 35 1 20 5 35-2 23-4 38 0 20 3 35-1',
	'M24 86c15 3 25-5 39 0s23 4 36-1 18-7 31 0 21 4 33-2 18-6 29 1 19 5 35-1 22-7 36 0 20 4 34-1',
	'M24 110c16-4 25 5 40 0s20-3 33 1 20 5 34-1 18-8 30 0 21 6 34-2 20-5 34 1 19 3 33-1 22-7 37 0',
	'M24 134c14 2 23-4 37 0s22 5 35-1 18-4 31 0 21 6 34-2 18-8 30 0 22 4 36-1 20-5 34 1 21 3 35-1',
	'M24 158c16-3 24 4 38 0s20-6 32 1 21 5 35-2 17-5 29 1 20 6 34-2 18-7 31 0 21 4 34-1 20-5 34 1',
	'M24 182c14 4 24-5 39 0s21 3 34-1 19-6 31 0 21 5 35-1 18-9 30 0 22 7 36-2 19-4 33 1 20 4 34-1',
	'M24 206c16-2 25 5 40 0s19-5 32 1 21 4 34-1 19-7 31 0 21 6 35-2 17-5 29 1 21 5 35-1 20-6 34 0',
	'M24 230c15 3 24-4 38 0s22 6 35-2 17-4 30 1 20 5 34-1 19-8 31 0 22 5 35-1 19-6 33 1 21 4 35-1',
	'M24 254c15-4 25 4 40 0s20-3 33 1 19 4 32-1 20-7 32 0 22 6 35-2 18-5 30 1 21 4 35-1 20-5 34 0',
];

const salient = [
	{ x: 118, y: 62 }, { x: 148, y: 86 }, { x: 180, y: 110 },
	{ x: 214, y: 134 }, { x: 250, y: 158 }, { x: 287, y: 182 },
	{ x: 325, y: 206 },
];

const activeCells = new Set([5, 12, 13, 20, 21, 22, 29, 30, 37, 45]);
const matrixCells = Array.from({ length: 56 }, (_, index) => ({
	index,
	x: 40 + (index % 8) * 30,
	y: 46 + Math.floor(index / 8) * 30,
	active: activeCells.has(index),
}));
---

<figure class="signal-structure" aria-labelledby="signal-structure-title" aria-describedby="signal-structure-caption">
	<header class="plate-heading">
		<div>
			<p class="plate-kicker">Conceptual sequence</p>
			<h3 id="signal-structure-title">Signal becomes structure.</h3>
		</div>
		<p class="plate-context">Dense input · sparse relevance · adaptive response</p>
	</header>

	<div class="stages">
		<section class="stage sensor-stage" aria-labelledby="physical-signal-label">
			<header class="stage-heading">
				<span>01</span>
				<div><p id="physical-signal-label">Physical signal</p><small>Dense, continuous, noisy</small></div>
			</header>
			<svg viewBox="0 0 430 300" role="presentation" aria-hidden="true">
				<defs>
					<linearGradient id="sensor-trace" x1="0" x2="1">
						<stop offset="0" stop-color="var(--blue-soft)" stop-opacity=".28" />
						<stop offset=".62" stop-color="var(--blue)" stop-opacity=".72" />
						<stop offset="1" stop-color="var(--sand)" stop-opacity=".18" />
					</linearGradient>
					<linearGradient id="structure-trace" x1="0" x2="1">
						<stop offset="0" stop-color="var(--yellow)" />
						<stop offset="1" stop-color="var(--orange)" />
					</linearGradient>
				</defs>
				<g class="sensor-grid">
					<path d="M24 38H404M24 278H404" />
					<path d="M86 38V278M150 38V278M214 38V278M278 38V278M342 38V278" />
				</g>
				<g class="noise-traces">
					{traces.map((trace) => <path d={trace} />)}
				</g>
				<path class="correlation-line" pathLength="100" d="M118 62C148 81 157 94 180 110S232 148 250 158s53 35 75 48" />
				<g class="salient-events">
					{salient.map((event, index) => (
						<g style={`--event-order: ${index}`}>
							<circle class="event-halo" cx={event.x} cy={event.y} r="11" />
							<circle class="event-core" cx={event.x} cy={event.y} r="3.5" />
						</g>
					))}
				</g>
				<text class="micro-note" x="24" y="294">CORRELATED CHANGE EMERGES ACROSS CHANNELS</text>
			</svg>
		</section>

		<section class="stage encoding-stage" aria-labelledby="encoding-label">
			<header class="stage-heading">
				<span>02</span>
				<div><p id="encoding-label">Salient structure</p><small>Local event encoding</small></div>
			</header>
			<svg viewBox="0 0 300 300" role="presentation" aria-hidden="true">
				<g class="branch-field">
					<path d="M24 58C84 58 91 146 152 146" />
					<path d="M24 104C78 104 94 146 152 146" />
					<path d="M24 150H152" />
					<path d="M24 196C78 196 94 154 152 154" />
					<path d="M24 242C84 242 91 154 152 154" />
					<path class="branch-out" d="M152 150C188 150 202 72 252 72M152 150H264M152 150C188 150 202 228 252 228" />
				</g>
				<g class="branch-terminals">
					<circle cx="24" cy="58" r="4" /><circle cx="24" cy="104" r="4" /><circle cx="24" cy="150" r="4" />
					<circle cx="24" cy="196" r="4" /><circle cx="24" cy="242" r="4" />
				</g>
				<circle class="local-state" cx="152" cy="150" r="18" />
				<g class="encoded-packets">
					<circle style="--packet-y: -78px; --packet-delay: 0s" cx="152" cy="150" r="4" />
					<circle style="--packet-y: 0px; --packet-delay: .35s" cx="152" cy="150" r="4" />
					<circle style="--packet-y: 78px; --packet-delay: .7s" cx="152" cy="150" r="4" />
				</g>
				<g class="feedback-mark">
					<path pathLength="100" d="M254 270H78" />
					<circle cx="254" cy="270" r="3" />
				</g>
				<text class="micro-note" x="24" y="294">INFORMATION, NOT EVERY SAMPLE</text>
			</svg>
		</section>

		<section class="stage state-stage" aria-labelledby="adaptive-state-label">
			<header class="stage-heading">
				<span>03</span>
				<div><p id="adaptive-state-label">Adaptive state</p><small>Local inference and response</small></div>
			</header>
			<svg viewBox="0 0 340 300" role="presentation" aria-hidden="true">
				<defs>
					<linearGradient id="state-spectrum" x1="0" x2="1">
						<stop offset="0" stop-color="var(--yellow)" />
						<stop offset=".52" stop-color="var(--green-soft)" />
						<stop offset="1" stop-color="var(--blue)" />
					</linearGradient>
				</defs>
				<g class="state-matrix">
					{matrixCells.map((cell) => (
						<rect
							class:list={['state-cell', { active: cell.active }]}
							x={cell.x}
							y={cell.y}
							width="19"
							height="19"
							rx="2"
							style={cell.active ? `--cell-delay: ${(cell.index % 5) * 0.12}s` : undefined}
						/>
					))}
				</g>
				<path class="state-contour" d="M286 36C326 84 326 216 286 264" />
				<g class="state-readout">
					<path d="M40 270H264" />
					<circle cx="264" cy="270" r="4" />
				</g>
				<text class="micro-note" x="40" y="294">A SMALL ASSEMBLY CHANGES STATE</text>
			</svg>
		</section>
	</div>

	<figcaption id="signal-structure-caption">
		Dense sensory streams can contain sparse, structured changes that matter for real-world interaction. Neuromorphic systems can encode those changes near the sensor and update internal state without treating every sample as equally informative. <span>Conceptual illustration.</span>
	</figcaption>
</figure>

<style>
	.signal-structure {
		--cycle: 12s;
		--graphite: #081f3d;
		--graphite-raised: #0f2e52;
		--blue: #2e6f9e;
		--blue-soft: #82a8c3;
		--gold: #c9a22e;
		--yellow: #f0d35a;
		--amber: var(--yellow);
		--orange: #d86f2f;
		--green: #568a5b;
		--green-soft: #82ad79;
		--sand: #f2ecdc;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		margin: clamp(2.5rem, 6vw, 5rem) 0 0;
		border: 1px solid rgb(240 211 90 / 30%);
		border-radius: .35rem;
		background:
			radial-gradient(circle at 83% 34%, rgb(46 111 158 / 16%), transparent 28rem),
			radial-gradient(circle at 58% 80%, rgb(86 138 91 / 13%), transparent 30rem),
			linear-gradient(145deg, var(--graphite), var(--graphite-raised));
		box-shadow: 0 1.6rem 4rem rgb(8 31 61 / 16%);
		color: var(--sand);
	}

	.signal-structure::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		background-image: radial-gradient(circle, rgb(242 236 220 / 8%) 0 1px, transparent 1.5px);
		background-size: 1.5rem 1.5rem;
		mask-image: linear-gradient(125deg, transparent 8%, #000 65%, transparent 96%);
		content: '';
	}

	.plate-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 2rem;
		border-bottom: 1px solid rgb(242 236 220 / 13%);
		padding: clamp(1.4rem, 3vw, 2.2rem);
	}

	.plate-kicker,
	.plate-context,
	.stage-heading p,
	.stage-heading small { margin: 0; text-transform: uppercase; }

	.plate-kicker { margin-bottom: .4rem; color: var(--amber); font-size: .65rem; font-weight: 760; letter-spacing: .2em; }
	.plate-heading h3 { margin: 0; color: var(--sand); font-size: clamp(1.45rem, 3vw, 2.15rem); font-weight: 560; letter-spacing: -.025em; }
	.plate-context { color: rgb(242 236 220 / 50%); font-size: .62rem; font-weight: 700; letter-spacing: .17em; text-align: right; }

	.stages { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(14rem, .8fr) minmax(17rem, 1fr); }
	.stage { min-width: 0; padding: clamp(1.2rem, 2.4vw, 1.8rem); }
	.stage + .stage { border-left: 1px solid rgb(242 236 220 / 12%); }
	.stage-heading { display: flex; align-items: flex-start; gap: .85rem; min-height: 3.7rem; }
	.stage-heading > span { color: var(--amber); font-size: .62rem; font-weight: 780; letter-spacing: .16em; }
	.stage-heading p { color: var(--sand); font-size: .7rem; font-weight: 740; letter-spacing: .14em; }
	.stage-heading small { display: block; margin-top: .28rem; color: rgb(242 236 220 / 46%); font-size: .55rem; letter-spacing: .11em; }
	.stage svg { display: block; width: 100%; height: auto; overflow: visible; }

	.sensor-grid path { fill: none; stroke: rgb(130 168 195 / 13%); stroke-width: 1; vector-effect: non-scaling-stroke; }
	.noise-traces path { fill: none; stroke: url(#sensor-trace); stroke-linecap: round; stroke-width: 1.1; vector-effect: non-scaling-stroke; animation: signal-breathe var(--cycle) ease-in-out infinite; animation-delay: -2.5s; }
	.noise-traces path:nth-child(3n + 2) { animation-delay: -4s; }
	.noise-traces path:nth-child(3n) { animation-delay: -5.5s; }
	.correlation-line { fill: none; stroke: url(#structure-trace); stroke-dasharray: 100; stroke-dashoffset: 100; stroke-linecap: round; stroke-width: 1.4; opacity: 0; vector-effect: non-scaling-stroke; animation: reveal-structure var(--cycle) ease-in-out infinite; animation-delay: -2.5s; }
	.salient-events g { opacity: 0; transform-box: fill-box; transform-origin: center; animation: event-emerge var(--cycle) ease-in-out infinite; animation-delay: calc(-2.5s + var(--event-order) * .08s); }
	.event-halo { fill: var(--orange); opacity: .14; }
	.event-core { fill: var(--yellow); }

	.branch-field path { fill: none; stroke: rgb(130 168 195 / 27%); stroke-linecap: round; stroke-width: 1.2; vector-effect: non-scaling-stroke; }
	.branch-field .branch-out { stroke: rgb(201 162 46 / 52%); }
	.branch-terminals circle { fill: var(--blue-soft); opacity: .52; }
	.local-state { fill: rgb(86 138 91 / 28%); stroke: var(--yellow); stroke-width: 1.2; animation: local-state-cycle var(--cycle) ease-in-out infinite; animation-delay: -2.5s; }
	.encoded-packets circle { fill: var(--amber); opacity: 0; transform-box: fill-box; transform-origin: center; animation: event-travel var(--cycle) ease-in-out infinite; animation-delay: calc(-2.5s + var(--packet-delay)); }
	.feedback-mark path { fill: none; stroke: var(--green-soft); stroke-dasharray: 3 97; stroke-linecap: round; stroke-width: 1.5; opacity: 0; animation: feedback-path var(--cycle) linear infinite; animation-delay: -2.5s; }
	.feedback-mark circle { fill: var(--green-soft); opacity: 0; transform-box: fill-box; transform-origin: center; animation: feedback-pulse var(--cycle) ease-in-out infinite; animation-delay: -2.5s; }

	.state-cell { fill: rgb(130 168 195 / 9%); stroke: rgb(242 236 220 / 10%); stroke-width: .7; }
	.state-cell.active { fill: url(#state-spectrum); opacity: .12; animation: state-response var(--cycle) ease-in-out infinite; animation-delay: calc(-2.5s + var(--cell-delay)); }
	.state-contour { fill: none; stroke: url(#state-spectrum); stroke-width: 1.2; opacity: .25; vector-effect: non-scaling-stroke; }
	.state-readout path { fill: none; stroke: rgb(130 173 121 / 45%); stroke-width: 1; vector-effect: non-scaling-stroke; }
	.state-readout circle { fill: var(--green-soft); opacity: .25; animation: readout-cycle var(--cycle) ease-in-out infinite; animation-delay: -2.5s; }
	.micro-note { fill: rgb(242 236 220 / 38%); font-family: var(--font-sans); font-size: 6.5px; font-weight: 720; letter-spacing: .16em; }

	figcaption {
		border-top: 1px solid rgb(242 236 220 / 13%);
		padding: 1.2rem clamp(1.4rem, 3vw, 2.2rem) 1.35rem;
		color: rgb(242 236 220 / 66%);
		font-size: .82rem;
		line-height: 1.65;
	}
	figcaption span { color: rgb(242 236 220 / 40%); }

	@keyframes signal-breathe {
		0%, 100% { opacity: .55; transform: translateX(0); }
		45% { opacity: .9; transform: translateX(3px); }
	}
	@keyframes reveal-structure {
		0%, 11%, 57%, 100% { opacity: 0; stroke-dashoffset: 100; }
		18% { opacity: .3; }
		38%, 47% { opacity: .9; stroke-dashoffset: 0; }
	}
	@keyframes event-emerge {
		0%, 14%, 58%, 100% { opacity: 0; transform: scale(.45); }
		26%, 46% { opacity: 1; transform: scale(1); }
		52% { opacity: .35; transform: scale(.75); }
	}
	@keyframes local-state-cycle {
		0%, 24%, 100% { opacity: .35; transform: scale(.8); transform-origin: 152px 150px; }
		40%, 63% { opacity: 1; transform: scale(1); transform-origin: 152px 150px; }
		78% { opacity: .48; transform: scale(.9); transform-origin: 152px 150px; }
	}
	@keyframes event-travel {
		0%, 34% { opacity: 0; transform: translate(0, 0); }
		40% { opacity: 1; }
		62% { opacity: 1; transform: translate(104px, var(--packet-y)); }
		69%, 100% { opacity: 0; transform: translate(104px, var(--packet-y)); }
	}
	@keyframes state-response {
		0%, 48%, 100% { opacity: .1; }
		59% { opacity: .92; }
		76% { opacity: .56; }
		91% { opacity: .18; }
	}
	@keyframes readout-cycle {
		0%, 54%, 100% { opacity: .18; transform: scale(.7); transform-origin: 264px 270px; }
		67%, 82% { opacity: 1; transform: scale(1.35); transform-origin: 264px 270px; }
	}
	@keyframes feedback-path {
		0%, 76% { opacity: 0; stroke-dashoffset: 0; }
		79% { opacity: .8; }
		91% { opacity: .8; stroke-dashoffset: -97; }
		94%, 100% { opacity: 0; stroke-dashoffset: -97; }
	}
	@keyframes feedback-pulse {
		0%, 76%, 100% { opacity: 0; transform: translateX(0); }
		79% { opacity: 1; }
		91% { opacity: 1; transform: translateX(-176px); }
		94% { opacity: 0; transform: translateX(-176px); }
	}

	@media (max-width: 58rem) {
		.plate-heading { align-items: flex-start; }
		.stages { grid-template-columns: 1fr; }
		.stage + .stage { border-top: 1px solid rgb(242 236 220 / 12%); border-left: 0; }
		.stage svg { max-height: 22rem; }
	}

	@media (max-width: 38rem) {
		.plate-heading { flex-direction: column; gap: .9rem; }
		.plate-context { text-align: left; }
		.stage { padding: 1rem; }
		.stage svg { max-height: 18rem; }
		figcaption { font-size: .77rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.noise-traces path { animation: none !important; opacity: .72; transform: none; }
		.correlation-line { animation: none !important; opacity: .72; stroke-dashoffset: 0; }
		.salient-events g { animation: none !important; opacity: .9; transform: none; }
		.local-state { animation: none !important; opacity: .8; transform: none; }
		.encoded-packets circle { animation: none !important; opacity: .85; transform: translate(104px, var(--packet-y)); }
		.feedback-mark path { animation: none !important; opacity: .35; stroke-dasharray: 3 10; }
		.feedback-mark circle { animation: none !important; opacity: .65; transform: translateX(-88px); }
		.state-cell.active { animation: none !important; opacity: .72; }
		.state-readout circle { animation: none !important; opacity: .8; transform: none; }
	}
</style>
