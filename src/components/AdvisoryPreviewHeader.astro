---
import AdvisoryPreviewWordmark from './AdvisoryPreviewWordmark.astro';
import { navigation, siteBase } from '../data/site';

interface Props {
	preview?: boolean;
}

const { preview = true } = Astro.props;
const pathname = Astro.url.pathname;
const homeHref = preview ? `${siteBase}/advisory-preview/` : `${siteBase}/`;
const previewNavigation = navigation.map((item, index) => ({
	...item,
	href: index === 0 ? homeHref : item.href,
}));

const isCurrent = (href: string) => {
	if (href === `${siteBase}/`) return pathname === href;
	return pathname.startsWith(href);
};
---

<header class="site-header">
	<div class="container header-inner">
		<AdvisoryPreviewWordmark href={homeHref} inverse />
		<nav aria-label="Main navigation">
			<ul>
				{previewNavigation.map((item) => (
					<li>
						<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		border-bottom: 1px solid rgb(240 211 90 / 24%);
		background: rgb(8 31 61 / 97%);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		min-height: 5.4rem;
	}

	nav ul {
		display: flex;
		align-items: center;
		gap: clamp(0.65rem, 2vw, 1.5rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		position: relative;
		color: rgb(242 236 220 / 72%);
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--sand);
	}

	nav a[aria-current='page']::after {
		position: absolute;
		right: 0;
		bottom: -0.55rem;
		left: 0;
		height: 2px;
		background: var(--amber);
		content: '';
	}

	@media (max-width: 61rem) {
		.header-inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.8rem;
			padding-block: 1rem;
		}

		nav {
			width: 100%;
			overflow-x: auto;
			padding-bottom: 0.55rem;
			scrollbar-width: none;
		}

		nav::-webkit-scrollbar {
			display: none;
		}

		nav ul {
			width: max-content;
		}
	}
</style>
