<style>
	.spike-matrix {
		position: relative;
		min-height: 27rem;
		overflow: hidden;
		border: 1px solid rgb(200 217 225 / 60%);
		border-radius: 1.25rem;
		background:
			radial-gradient(circle at 80% 28%, rgb(111 150 170 / 14%), transparent 45%),
			linear-gradient(145deg, rgb(255 255 255 / 88%), rgb(231 240 243 / 58%));
		box-shadow: var(--shadow-soft);
	}

	svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		padding: 0.5rem;
	}

	.matrix-plane {
		fill: url(#matrix-fade);
		stroke: rgb(49 95 123 / 22%);
		stroke-width: 1;
	}

	.matrix-cells {
		fill: url(#state-cells);
		color: var(--blue-500);
		opacity: 0.26;
	}

	:global(#state-cells rect) {
		fill: currentColor;
	}

	.infrastructure-lines path {
		fill: none;
		stroke: rgb(49 95 123 / 15%);
		stroke-dasharray: 3 7;
		stroke-width: 1;
	}

	.state-depth rect {
		fill: var(--blue-500);
		opacity: 0.018;
	}

	.state-depth rect:nth-child(2) { opacity: 0.035; }
	.state-depth rect:nth-child(3) { opacity: 0.055; }

	.zone-labels text {
		fill: var(--blue-700);
		font-family: var(--font-sans);
		font-size: 9px;
		font-weight: 800;
		letter-spacing: 0.18em;
		opacity: 0.55;
	}

	.spike-trains path {
		fill: none;
		stroke: var(--navy-800);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
		vector-effect: non-scaling-stroke;
	}

	.spike-trains path:nth-child(even) { opacity: 0.67; }

	.spike-events g {
		animation: spike-cycle 8s linear infinite;
		animation-delay: var(--delay);
		transform-box: fill-box;
		transform-origin: center bottom;
	}

	.spike-events line {
		stroke: var(--orange-500);
		stroke-linecap: round;
		stroke-width: 3;
		vector-effect: non-scaling-stroke;
	}

	.spike-events circle {
		fill: var(--orange-500);
	}

	.routes path {
		fill: none;
		stroke: rgb(49 95 123 / 30%);
		stroke-dasharray: 3 5;
		stroke-linecap: round;
		stroke-width: 1.4;
		vector-effect: non-scaling-stroke;
	}

	.event-packets path {
		fill: none;
		stroke: var(--orange-500);
		stroke-dasharray: 5 95;
		stroke-linecap: round;
		stroke-width: 5;
		animation: packet-cycle 8s linear infinite;
		animation-delay: var(--delay);
		vector-effect: non-scaling-stroke;
	}

	.activation-glows circle {
		fill: var(--orange-500);
		filter: url(#soft-glow);
		opacity: 0;
		animation: glow-cycle 8s ease-out infinite;
		animation-delay: var(--delay);
		transform-box: fill-box;
		transform-origin: center;
	}

	.active-cells rect {
		fill: var(--orange-500);
		opacity: 0;
		animation: cell-cycle 8s ease-out infinite;
		animation-delay: var(--delay);
	}

	.active-cells .response {
		fill: var(--blue-700);
		animation-delay: calc(var(--delay) + 0.18s);
	}

	.active-cells .response-late {
		fill: var(--blue-500);
		animation-delay: calc(var(--delay) + 0.36s);
	}

	@keyframes spike-cycle {
		0%, 6%, 100% { opacity: 0; transform: scaleY(0.1); }
		7% { opacity: 1; transform: scaleY(1); }
		10% { opacity: 0.9; transform: scaleY(0.78); }
		14% { opacity: 0; transform: scaleY(0.1); }
	}

	@keyframes packet-cycle {
		0%, 9% { opacity: 0; stroke-dashoffset: 0; }
		10% { opacity: 1; stroke-dashoffset: 0; }
		29% { opacity: 1; stroke-dashoffset: -95; }
		31%, 100% { opacity: 0; stroke-dashoffset: -95; }
	}

	@keyframes glow-cycle {
		0%, 27%, 100% { opacity: 0; transform: scale(0.35); }
		31% { opacity: 0.22; transform: scale(1); }
		45% { opacity: 0; transform: scale(1.75); }
	}

	@keyframes cell-cycle {
		0%, 27%, 100% { opacity: 0; }
		31% { opacity: 0.92; }
		38% { opacity: 0.5; }
		58% { opacity: 0; }
	}

	@media (max-width: 34rem) {
		.spike-matrix {
			min-height: 21rem;
		}
	}
</style>
