---
import { getCollection } from 'astro:content';
import DiscoveryCard from '../../components/DiscoveryCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import reviewQueue from '../../data/discovery-review-queue.json';
import { githubRepositoryUrl, sortDiscoveries } from '../../lib/discovery';
import { getLocalReviewQueue, localReviewEnabled } from '../../lib/local-review';
import LocalReviewActions from '../../components/LocalReviewActions.astro';

const candidateIds = new Set(reviewQueue.candidateIds);
const localQueue = await getLocalReviewQueue();
const entries = localReviewEnabled ? localQueue.entries : sortDiscoveries(
	await getCollection(
		'discoveries',
		({ data }) => !data.internal && candidateIds.has(data.candidateId),
	),
);
const pending = localQueue.entries.filter((entry) => entry.reviewStatus === 'candidate');
const kept = localQueue.entries.filter((entry) => entry.reviewStatus === 'approved');
---

<SiteLayout
	title="Editorial review"
	description="Review AI-assisted content proposals before they are published by Neuromorphic Sweden."
	noindex
	bodyClass="review-site"
>
	<section class="review-hero">
		<div class="container review-hero-grid">
			<div>
				<p class="eyebrow">Editorial review</p>
				<h1>Review the evidence before publishing.</h1>
				<p class="lead">
					{localReviewEnabled ? 'Review local drafts in the website’s real layout. Keep selects an article for the next upload; Discard records your decision in the local crawler database. Nothing is committed or published by these buttons.' : <>This unlisted workspace renders crawler-prepared records in the website's real layout.
					The material is publicly readable but is not part of the main navigation and must not be
					considered published until its pull request has been approved and merged.</>}
				</p>
			</div>
			<aside class="review-notice" aria-labelledby="github-review-title">
				<p class="eyebrow">GitHub publication</p>
				<h2 id="github-review-title">Merging is publishing.</h2>
				<ol>
					{localReviewEnabled ? <>
						<li>Open a draft and compare it with the original source.</li>
						<li>Click <strong>Keep for upload</strong> or <strong>Discard</strong>.</li>
						<li>Run <code>crawler_service.py publish-review</code> from the local crawler folder. Only kept records are uploaded.</li>
						<li>On GitHub, open the pull request’s <strong>Conversation</strong> tab and merge into <code>main</code> when ready.</li>
					</> : <>
					<li>Open a proposed record and compare it with the original source.</li>
					<li>Use <strong>Edit</strong> to correct the record in its GitHub branch.</li>
					<li>Use <strong>Delete</strong> to remove an unsuitable file or reject its pull request.</li>
					<li>Use <strong>Publish</strong> to open the pull request, approve it and merge it into <code>main</code>.</li>
					</>}
				</ol>
				<p>Only people with suitable repository access can edit, approve or merge.</p>
				<a class="button secondary" href={`${githubRepositoryUrl}/pulls`}>Open pull requests <span aria-hidden="true">↗</span></a>
			</aside>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading">
				<div><p class="eyebrow">{localReviewEnabled ? 'Local selection' : 'Material in this build'}</p><h2>{localReviewEnabled ? `${pending.length} pending · ${kept.length} kept for upload.` : `${entries.length} records to inspect.`}</h2></div>
				<p>Titles lead to full review pages with summaries, provenance, AI metadata and supporting evidence.</p>
			</div>

			{localReviewEnabled ? <>
				{localQueue.error && <p class="empty-state" role="alert">{localQueue.error}</p>}
				<h3>Pending decisions</h3>
				{pending.length === 0 && !localQueue.error && <p>No pending drafts. Run the crawler again to discover new material.</p>}
				<div class="review-grid">
					{pending.map((entry) => <div><DiscoveryCard entry={entry} review /><LocalReviewActions candidateId={entry.data.candidateId} token={localQueue.token} status="candidate" /></div>)}
				</div>
				{kept.length > 0 && <section class="kept-section"><h3>Kept for the next upload</h3><div class="review-grid">
					{kept.map((entry) => <div><DiscoveryCard entry={entry} review /><LocalReviewActions candidateId={entry.data.candidateId} token={localQueue.token} status="approved" /></div>)}
				</div></section>}
			</> : entries.length > 0 ? (
				<div class="review-grid">
					{entries.map((entry) => <DiscoveryCard entry={entry} review />)}
				</div>
			) : (
				<div class="empty-state">
					<h3>No crawler proposals are included in this build.</h3>
					<p>Run the local discovery service, export candidates and push its review branch. This page will populate automatically when that branch is built.</p>
				</div>
			)}
		</div>
	</section>
</SiteLayout>

<style>
	.kept-section { margin-top: 4rem; }
	.review-grid > div { display: flex; flex-direction: column; }
	.review-hero {
		border-bottom: 1px solid var(--line);
		background:
			radial-gradient(circle at 90% 5%, rgb(224 107 45 / 12%), transparent 28rem),
			linear-gradient(125deg, var(--blue-50), var(--page));
		padding-block: clamp(4rem, 8vw, 7rem);
	}

	.review-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
		gap: clamp(2rem, 7vw, 7rem);
		align-items: start;
	}

	.review-hero h1 {
		max-width: 48rem;
		margin-bottom: 1.5rem;
	}

	.review-notice {
		border: 1px solid var(--blue-200);
		border-radius: 1rem;
		background: rgb(255 255 255 / 86%);
		padding: clamp(1.4rem, 3vw, 2.2rem);
		box-shadow: var(--shadow-soft);
	}

	.review-notice h2 {
		font-family: var(--font-sans);
		font-size: 1.45rem;
		font-weight: 750;
		letter-spacing: -0.01em;
	}

	.review-notice ol {
		padding-left: 1.25rem;
	}

	.review-notice li + li {
		margin-top: 0.65rem;
	}

	.review-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.empty-state {
		border: 1px dashed var(--blue-500);
		border-radius: 1rem;
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.empty-state p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 64rem) {
		.review-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 52rem) {
		.review-hero-grid,
		.review-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
