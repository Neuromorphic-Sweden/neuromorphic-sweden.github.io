---
import BaseLayout from './BaseLayout.astro';
import AdvisoryPreviewHeader from '../components/AdvisoryPreviewHeader.astro';
import AdvisoryPreviewFooter from '../components/AdvisoryPreviewFooter.astro';

interface Props {
	title: string;
	description: string;
	preview?: boolean;
}

const { title, description, preview = true } = Astro.props;
---

<BaseLayout
	title={preview ? `${title} — Neuromorphic Sweden design preview` : title}
	description={description}
	noindex={preview}
	bodyClass="advisory-preview"
	faviconHref="/favicon.png"
	themeColor="#081f3d"
>
	{preview && (
		<div class="advisory-banner" role="status">
			<div class="container">
				<div>
					<strong>Advisory design preview</strong>
					<span>Unpublished proposal for review and discussion.</span>
				</div>
				<a href="/">Return to the current homepage <span aria-hidden="true">→</span></a>
			</div>
		</div>
	)}
	<AdvisoryPreviewHeader preview={preview} />
	<main id="main-content">
		<slot />
	</main>
	<AdvisoryPreviewFooter />
</BaseLayout>

<style is:global>
	body.advisory-preview {
		/* Swedish semiconductor-inspired palette, balanced with a botanical green. */
		--deep-blue: #081f3d;
		--deep-blue-raised: #0f2e52;
		--blue: #2e6f9e;
		--blue-soft: #82a8c3;
		--gold: #c9a22e;
		--yellow: #f0d35a;
		--orange: #b9521d;
		--green: #568a5b;
		--green-soft: #82ad79;
		--cream: #f2ecdc;
		--cream-soft: #f8f4e9;
		--graphite: var(--deep-blue);
		--graphite-raised: var(--deep-blue-raised);
		--graphite-soft: #18406c;
		--amber: var(--yellow);
		--amber-deep: var(--orange);
		--sand: var(--cream);
		--sand-soft: var(--cream-soft);
		--violet: var(--green);
		--cyan: var(--blue);
		--navy-950: var(--graphite);
		--navy-900: var(--graphite-raised);
		--navy-800: var(--graphite-soft);
		--blue-700: #245b85;
		--blue-500: var(--blue);
		--blue-200: #b8cedd;
		--blue-100: #dce8ec;
		--blue-50: #eef3f3;
		--white: #fffdf7;
		--orange-600: var(--amber-deep);
		--orange-500: #d86f2f;
		--orange-100: #f2d8bf;
		--ink: var(--graphite);
		--muted: #606771;
		--line: #cec5ae;
		--page: var(--sand);
		--font-display: var(--font-sans);
		--shadow-soft: 0 24px 70px rgb(8 31 61 / 11%);
		background: var(--page);
	}

	body.advisory-preview::selection {
		background: var(--amber);
		color: var(--graphite);
	}

	body.advisory-preview h1,
	body.advisory-preview h2 {
		font-weight: 620;
		letter-spacing: -.035em;
	}

	body.advisory-preview .eyebrow {
		color: var(--amber-deep);
	}

	body.advisory-preview .eyebrow::before {
		width: 1.7rem;
		height: 1px;
		border-radius: 0;
		background: currentColor;
	}

	body.advisory-preview .button {
		gap: .55rem;
		font-weight: 720;
	}

	body.advisory-preview .button:hover {
		transform: translateY(-1px);
	}

	body.advisory-preview .section.dark {
		background: var(--graphite);
	}

	body.advisory-preview .section.dark p,
	body.advisory-preview .section.dark li {
		color: rgb(242 236 220 / 74%);
	}

	body.advisory-preview .card {
		background: rgb(255 253 247 / 68%);
	}

	.advisory-banner {
		border-bottom: 1px solid rgb(8 31 61 / 22%);
		background: var(--gold);
		color: var(--graphite);
	}

	.advisory-banner .container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		min-height: 3.25rem;
		padding-block: .55rem;
	}

	.advisory-banner div div {
		display: flex;
		flex-wrap: wrap;
		gap: .15rem .8rem;
		align-items: baseline;
	}

	.advisory-banner strong,
	.advisory-banner a {
		color: var(--graphite);
		font-size: .78rem;
		font-weight: 780;
	}

	.advisory-banner span {
		font-size: .76rem;
	}

	.advisory-banner a {
		white-space: nowrap;
		text-decoration-color: rgb(8 31 61 / 48%);
	}

	@media (max-width: 42rem) {
		.advisory-banner .container {
			align-items: flex-start;
			flex-direction: column;
			gap: .35rem;
		}
	}
</style>
